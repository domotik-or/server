[Unit]
Description=Server
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
WorkingDirectory=/home/franck/domotique/server
# Environment=""
ExecStart=/home/franck/domotique/server/.venv/bin/server -c /home/franck/domotique/server/config.toml
User=franck
Group=franck
Restart=on-failure
RestartSec=10s
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
